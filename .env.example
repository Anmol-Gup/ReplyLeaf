# --- Meta / WhatsApp Cloud API ---
# Pin the Graph API version here (never hard-code it). Check Meta's changelog before bumping.
GRAPH_API_VERSION=v26.0
# App Dashboard > App settings > Basic > App secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Any random string you choose; paste the SAME value into Meta's "Verify token" field.
WHATSAPP_VERIFY_TOKEN=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Public anon/publishable key (safe for the browser). The dashboard uses it with the owner's own login, so RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (platform-owned keys, server only, used from Stage 2) ---
# Get a Gemini key at aistudio.google.com. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: only needed if a client is switched to OpenAI.
OPENAI_API_KEY=
# Model IDs (providers retire models, so these are configurable). Defaults shown;
# check the provider's current model list before changing.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-6-luna

# --- Email (Gmail SMTP with an app password; see README) ---
# Create the app password at myaccount.google.com/apppasswords (needs 2-step verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional "From" address; defaults to GMAIL_USER.
MAIL_FROM=
# Where failures and daily-check problems are emailed.
ADMIN_ALERT_EMAIL=
# Public base URL of this app (used for dashboard links in emails), e.g. https://your-app.vercel.app
APP_URL=

# --- Embedded Signup v4 (self-service WhatsApp onboarding; Stage 6) ---
# REAL CLIENTS CAN ONLY ONBOARD AFTER META APPROVES YOUR APP AS A TECH PROVIDER.
# The token expiry is set in the portal configuration (we expect 60 days; the daily token-refresh job needs
# NEXT_PUBLIC_META_APP_ID and WHATSAPP_APP_SECRET). Both values are public (sent to the browser). Leave empty to switch the
# self-service page off; you can still connect numbers with `npm run create-client`.
# App ID: App Dashboard > App settings > Basic.
NEXT_PUBLIC_META_APP_ID=
# Facebook Login for Business configuration ID of your Embedded Signup configuration.
NEXT_PUBLIC_META_ES_CONFIG_ID=

# --- Admin API ---
# Optional. 24+ random chars. Enables admin-mode data deletion on /api/privacy/delete.
ADMIN_API_KEY=

# --- Cron ---
# Random string (16+ chars, required: the cron routes refuse to run without it). Vercel sends it as "Authorization: Bearer <value>" to /api/cron/sweep.
CRON_SECRET=

# --- Encryption (AES-256-GCM) for per-client secrets such as WhatsApp tokens ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Database password: John1204@1999@
