{
  "name": "wa-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:node": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test .build/tests/",
    "create-client": "npm run build:node && node --env-file=.env .build/scripts/create-client.js",
    "eval": "npm run build:node && node --env-file=.env .build/scripts/run-eval.js",
    "set-kb": "npm run build:node && node --env-file=.env .build/scripts/set-kb.js",
    "create-owner": "npm run build:node && node --env-file=.env .build/scripts/create-owner.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.109.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "openai": "^6.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
