    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/sweep",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/daily-check",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/token-refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/billing-reconcile",
      "schedule": "0 5 * * *"
    }
  ]
}
